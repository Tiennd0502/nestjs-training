{
  "apps": {
    "api": {
      "dir": "apps/api",
      "runner": "Vitest",
      "coverage": "pnpm run test:cov --coverage.reporter=json-summary --coverage.reporter=text-summary",
      "e2e": true,
      "planChanges": [
        "an endpoint or request/response shape",
        "an entity or migration"
      ],
      "security": [
        "src/common/guards/",
        "src/common/decorators/",
        "src/common/middlewares/",
        "src/common/providers/",
        "src/modules/webhook/",
        "src/configs/",
        "src/app.module.ts",
        "src/main.ts",
        "Dockerfile",
        "docker-compose.yml",
        "docker-compose.dev.yml"
      ],
      "ui": []
    },
    "web": {
      "dir": "apps/web",
      "runner": "Jest",
      "coverage": "pnpm run test:cov --coverageReporters=json-summary --coverageReporters=text-summary",
      "e2e": false,
      "planChanges": [
        "a route or page added or removed",
        "the src/middleware.ts matcher",
        "the apiClient/service result contract"
      ],
      "security": [
        "src/middleware.ts",
        "src/services/api.ts",
        "src/utils/api.ts",
        "src/providers/AuthTokenBridge.tsx",
        "src/components/RedirectCallback/",
        "next.config.ts",
        "vercel.json"
      ],
      "ui": [
        "src/{app,components,sections,layouts,theme}/**",
        "public/**",
        "tailwind.config.ts"
      ]
    }
  },
  "shared": [
    "packages/constants",
    "packages/schemas",
    "packages/eslint-config",
    "packages/prettier-config",
    "packages/typescript-config",
    "pnpm-workspace.yaml"
  ]
}
