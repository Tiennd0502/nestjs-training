{
  "plansDirectory": "specs",
  "permissions": {
    "allow": [
      "Bash(pnpm install*)",
      "Bash(pnpm run start*)",
      "Bash(pnpm run build*)",
      "Bash(pnpm run lint*)",
      "Bash(pnpm run format*)",
      "Bash(pnpm run test*)",
      "Bash(pnpm jest *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch --show-current)",
      "Read"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf*)"
    ]
  }
}
